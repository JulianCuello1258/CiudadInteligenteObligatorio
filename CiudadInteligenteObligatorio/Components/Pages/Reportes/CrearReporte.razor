@page "/reportes/nuevo"
@using CiudadInteligenteObligatorio.Models
@using CiudadInteligenteObligatorio.Service
@rendermode InteractiveServer
@inject ReporteApiService reporteApiService
@inject NavigationManager Navigation

<h3>Crear Reporte</h3>

@if (mensaje != null)
{
    <div class="alert alert-danger">@mensaje</div>
}

<EditForm Model="reporte" OnValidSubmit="GuardarReporte">
    <DataAnnotationsValidator />

    <label>Categoría</label>
    <InputSelect @bind-Value="reporte.CategoriaId" @bind-Value:after="CargarCategorias" class="form-select">
        <option value="0">Seleccione una categoría</option>
        @foreach (var categoria in categorias)
        {
            <option value="@categoria.Id">@categoria.Nombre</option>
        }
    </InputSelect>
    <ValidationMessage For="@(() => reporte.CategoriaId)" />

    <label class="mt-3">Tipo de problema</label>
    <InputSelect @bind-Value="reporte.TipoProblema" class="form-select" disabled="@(categoriaSeleccionada == null)">
        <option value="">Seleccione un tipo de problema</option>
        @if (categoriaSeleccionada != null)
        {
            @foreach (var tipoProblema in categoriaSeleccionada.Tipos)
            {
                <option value="@tipoProblema.Nombre">@tipoProblema.Nombre</option>
            }
        }
    </InputSelect>
    <ValidationMessage For="@(() => reporte.TipoProblema)" />

    <label class="mt-3">Descripción</label>
    <InputTextArea @bind-Value="reporte.Descripcion" class="form-control" rows="4" placeholder="Descripción del reporte" />
    <ValidationMessage For="@(() => reporte.Descripcion)" />

    <label class="mt-3">Dirección</label>
    <InputText @bind-Value="reporte.Direccion" class="form-control" placeholder="Ej: Calle Artigas 245, esquina Sarandí" />
    <ValidationMessage For="@(() => reporte.Direccion)" />

    <label class="mt-3">Barrio</label>
    <InputSelect @bind-Value="reporte.Barrio" class="form-select">
        <option value="">Seleccione un barrio</option>
        @foreach (var barrio in barrios)
        {
            <option value="@barrio.Nombre">@barrio.Nombre</option>
        }
    </InputSelect>
    <ValidationMessage For="@(() => reporte.Barrio)" />

    <label class="mt-3">Razón (opcional)</label>
    <InputText @bind-Value="reporte.Razon" class="form-control" placeholder="Ej: Raíces" />
    <ValidationMessage For="@(() => reporte.Razon)" />

    <label class="mt-3">Fotos (opcional, hasta 5, máx. 5 MB cada una)</label>
    <InputFile OnChange="SeleccionarImagen" multiple accept="image/*" class="form-control" />
    @if (errorFotos != null)
    {
        <div class="text-danger">@errorFotos</div>
    }
    @foreach (var imagen in imagenSeleccionadas)
    {
        <div class="small text-muted"> @imagen.Name (@(imagen.Size / 1024) KB)</div>
    }

    <button type="submit" class="btn btn-primary mt-3" disabled="@guardando">
        @(guardando ? "Enviando..." : "Enviar reporte")
    </button>
</EditForm>

@code {
    private ReporteCreateDto reporte = new();
    private List<Categoria> categorias = new();
    private List<Barrio> barrios = new();
    private Categoria? categoriaSeleccionada;
    private List<IBrowserFile> imagenSeleccionadas = new();
    private const int maxFotos = 5;
    private const long maxTamanio = 5 * 1024 * 1024; // 5 MB
    private string? errorFotos;
    private string? mensaje;
    private bool guardando = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categorias = await reporteApiService.GetCategoriasAsync();
            barrios = await reporteApiService.GetBarriosAsync();
        }
        catch (Exception)
        {
            mensaje = "No se pudieron cargar las categorías y los barrios.";
        }
    }

    private void SeleccionarImagen(InputFileChangeEventArgs e)
    {
        errorFotos = null;
        imagenSeleccionadas.Clear();

        if (e.FileCount > maxFotos)
        {
            errorFotos = $"Solo se permiten hasta {maxFotos} fotos.";
            return;
        }

        foreach (var archivo in e.GetMultipleFiles(maxFotos))
        {
            if (!archivo.ContentType.StartsWith("image/"))
            {
                errorFotos = $"{archivo.Name}: no es una imagen.";
                imagenSeleccionadas.Clear();
                return;
            }
            if (archivo.Size > maxTamanio)
            {
                errorFotos = $"{archivo.Name}: excede el tamaño máximo (5 MB).";
                imagenSeleccionadas.Clear();
                return;
            }
            imagenSeleccionadas.Add(archivo);
        }
    }

    private void CargarCategorias()
    {
        categoriaSeleccionada = categorias.FirstOrDefault(c => c.Id == reporte.CategoriaId);
        reporte.TipoProblema = "";
    }


    private async Task GuardarReporte()
    {
        if (guardando) return;
        guardando = true;
        mensaje = null;
        int? idCreado = null;

        try
        {
            var nuevo = await reporteApiService.CreateAsync(reporte);
            idCreado = nuevo.Id;

            foreach (var imagen in imagenSeleccionadas)
            {
                await reporteApiService.UploadFotosAsync(nuevo.Id, imagen);
            }
            Navigation.NavigateTo($"/reportes/{idCreado}");
        } 
        catch (Exception)
        {
            if (idCreado != null)
            {
                mensaje = $"Error al subir la imagen. El reporte se creó ({idCreado}), pero no se pudo subir la imagen.";
            }
            else 
            {
                mensaje = "Error al crear el reporte.";
            }
        }
        finally
        {
            guardando = false;
        }
    }
}